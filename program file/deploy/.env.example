# 环境变量模板：复制为 .env 后按需修改
# 运行 profile（容器内使用 prod：关闭 SQL stdout 日志）
SPRING_PROFILES_ACTIVE=prod

# 数据库
MYSQL_ROOT_PASSWORD=change-me-strong-password
MYSQL_DATABASE=campus_convert
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/campus_convert?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me-strong-password

# Redis
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# JWT
CAMPUS_JWT_SECRET=change-me-to-a-long-random-string
CAMPUS_JWT_TTL_HOURS=12

# 存储（本地模式）
CAMPUS_STORAGE_TYPE=local
CAMPUS_STORAGE_LOCAL_PATH=/data/campus-format/files
# 下载令牌有效期（分钟，一次性使用）
CAMPUS_STORAGE_DOWNLOAD_TOKEN_TTL_MINUTES=10

# 转换引擎二进制路径（容器内需预装 ffmpeg / libreoffice / imagemagick）
CAMPUS_ENGINE_FFMPEG_PATH=/usr/bin/ffmpeg
CAMPUS_ENGINE_LIBREOFFICE_PATH=/usr/bin/soffice
CAMPUS_ENGINE_PANDOC_PATH=/usr/bin/pandoc
CAMPUS_ENGINE_IMAGEMAGICK_PATH=/usr/bin/convert
# 可选引擎（未安装时对应能力 available=false）
CAMPUS_ENGINE_CAJ2PDF_PATH=caj2pdf
CAMPUS_ENGINE_DDJVU_PATH=ddjvu
CAMPUS_ENGINE_PAGES_COMMAND=
CAMPUS_ENGINE_TESSERACT_PATH=tesseract
CAMPUS_ENGINE_TESSERACT_LANG=chi_sim+eng
CAMPUS_ENGINE_PIX2TEX_PATH=pix2tex

# 队列与轮询
CAMPUS_QUEUE_PROVIDER=redis
CAMPUS_ENGINE_POLL_INTERVAL_MS=2000

# 限流（每分钟）
CAMPUS_RATE_LIMIT_LOGIN=10
CAMPUS_RATE_LIMIT_REGISTER=5
CAMPUS_RATE_LIMIT_UPLOAD=20
CAMPUS_RATE_LIMIT_TASK_CREATE=30

# 质检器：rule（默认）/ ai
CAMPUS_ENGINE_QC_PROVIDER=rule

# AI 增强：rule=本地规则引擎（默认，可离线）；llm=大模型 API（需另配 key）
CAMPUS_AI_ENABLED=true
CAMPUS_AI_PROVIDER=rule
# CAMPUS_AI_LLM_API_KEY=
# CAMPUS_AI_LLM_BASE_URL=
# CAMPUS_AI_LLM_MODEL=

# 配额默认值
CAMPUS_QUOTA_DAILY_LIMIT=20
CAMPUS_QUOTA_MAX_FILE_SIZE=200MB
CAMPUS_QUOTA_STORAGE_LIMIT=1GB
